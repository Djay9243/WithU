{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "WithU",
      "target-membership": [
        "WithU",
      ],
      "membership-exceptions": [
        {
          "target": "WithU",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "WithUWidgets",
      "target-membership": [
        "WithUWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "WithUWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "WithU Watch", "target-membership": [ "WithU Watch" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "WithU", "WithU Watch" ] },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "WithUWidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "WithUWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/WithU.app", "id": "510CF46230AB06ED0034FAB0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/WithUWidgetsExtension.appex", "id": "510CF4B630AB103D0034FAB0", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "WithU/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WithU Watch.app", "id": "510CF4D430AB98490034FAB0", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "WithU/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "WithU",
      "id": "510CF46130AB06ED0034FAB0",
      "product": "Products/WithU.app",
      "product-type": "application",
      "dependencies": [
        "WithUWidgetsExtension",
        "WithU Watch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "WithU/WithU.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "4T45FUQH42",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "WithU/Info.plist",
        "INFOPLIST_KEY_NSContactsUsageDescription": "WithU reads your contacts so you can pick the trusted people who get alerted if you miss a check-in.",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "Face ID confirms it's really you saying \"I'm safe\", so nobody else can cancel an alert on your phone.",
        "INFOPLIST_KEY_NSLocationAlwaysAndWhenInUseUsageDescription": "WithU keeps following your trip when the screen is locked so check-ins and arrival detection keep working. Tracking stops the moment the trip ends.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "WithU uses your location only while a trip is active, to detect arrival, long stops and leaving your route, and to share where you are with your trusted contacts.",
        "INFOPLIST_KEY_NSSupportsLiveActivities": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UIUserInterfaceStyle": "Automatic",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.jahanzaibali.withu",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "WithUWidgetsExtension",
      "id": "510CF4B530AB103D0034FAB0",
      "product": "Products/WithUWidgetsExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
